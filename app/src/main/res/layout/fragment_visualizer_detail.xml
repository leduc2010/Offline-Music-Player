<?xml version="1.0" encoding="utf-8"?>
<com.duc.offlinemusicplayer.presentation.widget.SafeAreaView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.75"
        android:background="@drawable/bg_player_gradient" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.112"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/bg_player_gradient_top" />

    <com.duc.offlinemusicplayer.presentation.ui.visualizer.widget.VisualizerView
        android:id="@+id/visualizerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/SquareImageButton"
            android:layout_marginStart="14dp"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Heading.H1.S.24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Car Bass" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Content Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Title Description -->
        <TextView
            android:id="@+id/tvDescHeader"
            style="@style/Body.Normal.M.16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Description body -->
        <TextView
            android:id="@+id/tvDescription"
            style="@style/Body.Small.R.14"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescHeader"
            tools:text="A beautiful visualizer" />

        <!-- Metadata pill -->
        <LinearLayout
            android:id="@+id/metaPills"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_collection_icon"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescription">

            <!-- File size icon/text -->
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_music_note"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvSize"
                style="@style/Label.Small.R.10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/text_secondary"
                tools:text="106 Kb" />

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="10dp"
                android:background="@color/divider" />

            <!-- Downloads icon/text -->
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_language_selector"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvDownloads"
                style="@style/Label.Small.R.10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/text_secondary"
                tools:text="228960" />
        </LinearLayout>

        <!-- Big download/apply button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAction"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_primary"
            android:textColor="@color/neutral_950"
            app:backgroundTint="@null"
            app:cornerRadius="100dp"
            app:layout_constraintTop_toBottomOf="@id/metaPills"
            tools:text="Download" />

        <!-- Download simulated progress bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="20dp"
            android:max="100"
            android:progressDrawable="@drawable/bg_progress_splash"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/metaPills" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.duc.offlinemusicplayer.presentation.widget.SafeAreaView>
