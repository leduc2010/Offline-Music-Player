<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shimmerLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_native_ad_color_1">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ad_loading_shimmer_bg_color"
            android:orientation="vertical"
            android:paddingVertical="@dimen/ad_native_space_vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_20"
                android:layout_marginHorizontal="@dimen/size_20"
                android:background="@drawable/shimmer_placeholder" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/ad_native_media_height"
                android:layout_marginHorizontal="@dimen/size_20"
                android:layout_marginTop="@dimen/size_4"
                android:background="@drawable/shimmer_placeholder" />

            <View
                style="@style/AdNative.CtaButton"
                android:layout_marginTop="@dimen/ad_native_space_vertical"
                android:background="@drawable/shimmer_placeholder" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
