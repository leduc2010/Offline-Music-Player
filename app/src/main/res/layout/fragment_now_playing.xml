<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Screen Full Background Image -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:src="@color/neutral_900" />

    <!-- Dark gradient overlay for modern look and readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_player_gradient" />

    <!-- Live Canvas Visualizer Overlay -->
    <com.duc.offlinemusicplayer.presentation.ui.visualizer.widget.VisualizerView
        android:id="@+id/visualizerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Header Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/SquareImageButton"
            android:layout_marginStart="14dp"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Heading2S"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnOption"
            style="@style/SquareImageButton"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Controlling area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controlArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Album Cover Art & Song Meta info container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/songMetaContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Rounded cover art -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvCover"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivCoverArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_music_note" />
            </androidx.cardview.widget.CardView>

            <!-- Song title and artist -->
            <TextView
                android:id="@+id/tvSongTitle"
                style="@style/Body.Normal.M.16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="16dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/white"
                app:layout_constraintBottom_toTopOf="@id/tvSongArtist"
                app:layout_constraintEnd_toStartOf="@id/btnFavorite"
                app:layout_constraintStart_toEndOf="@id/cvCover"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="Looking For Love For Love (Club Rem..." />

            <TextView
                android:id="@+id/tvSongArtist"
                style="@style/Label.Medium.M.12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="16dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text_secondary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnFavorite"
                app:layout_constraintStart_toEndOf="@id/cvCover"
                app:layout_constraintTop_toBottomOf="@id/tvSongTitle"
                tools:text="Ty Dolla $ign" />

            <!-- Favorite heart icon -->
            <ImageView
                android:id="@+id/btnFavorite"
                style="@style/SquareImageButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_heart"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Seekbar Slider -->
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:max="100"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressBackgroundTint="@color/neutral_800"
            android:progressTint="@color/green_primary"
            android:thumbTint="@color/white"
            app:layout_constraintTop_toBottomOf="@id/songMetaContainer" />

        <!-- Timing display -->
        <TextView
            android:id="@+id/tvTimeElapsed"
            style="@style/Label.Small.R.10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/seekBar"
            tools:text="00:00" />

        <TextView
            android:id="@+id/tvTimeDuration"
            style="@style/Label.Small.R.10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/seekBar"
            tools:text="04:02" />

        <!-- Control Buttons Container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/playbackControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/tvTimeElapsed">

            <!-- Middle: Play Pause circular white button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnPlayPauseCard"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="32dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/btnPlayPause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="center"
                    android:src="@drawable/ic_play"
                    app:tint="@color/neutral_950" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Skip Previous -->
            <ImageView
                android:id="@+id/btnPrevious"
                style="@style/SquareImageButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="20dp"
                android:src="@drawable/ic_skip_previous"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnPlayPauseCard"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

            <!-- Rewind 10s -->
            <ImageView
                android:id="@+id/btnRewind10"
                style="@style/SquareImageButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="24dp"
                android:src="@drawable/ic_rewind_10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnPrevious"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Skip Next -->
            <ImageView
                android:id="@+id/btnNext"
                style="@style/SquareImageButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/ic_skip_next"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnPlayPauseCard"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

            <!-- Forward 10s -->
            <ImageView
                android:id="@+id/btnForward10"
                style="@style/SquareImageButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="24dp"
                android:src="@drawable/ic_forward_10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnNext"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Bottom Options: Equalizer, Shuffle, Queue -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/playbackControls">

            <!-- Equalizer -->
            <LinearLayout
                android:id="@+id/btnEqualizer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_equalizer"
                    app:tint="@color/text_secondary" />

                <TextView
                    style="@style/Label.Small.R.10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Equalizer"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Shuffle -->
            <LinearLayout
                android:id="@+id/btnShuffle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_shuffle"
                    app:tint="@color/text_secondary" />

                <TextView
                    style="@style/Label.Small.R.10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Shuffle"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Queue -->
            <LinearLayout
                android:id="@+id/btnQueue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_queue"
                    app:tint="@color/text_secondary" />

                <TextView
                    style="@style/Label.Small.R.10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Queue"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
