<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="SafeAreaView">
        <attr name="enableSafeTop" format="boolean" />
        <attr name="enableSafeBottom" format="boolean" />
    </declare-styleable>

    <declare-styleable name="ToolbarView">
        <attr name="title" format="string" />
        <attr name="showBackIcon" format="boolean" />
    </declare-styleable>

    <declare-styleable name="CommonToolbarView">
        <attr name="ctvTitle" format="string" />
        <attr name="ctvTitleTextStyle" format="reference" />
        <attr name="ctvShowStartIcon" format="boolean" />
        <attr name="ctvShowEndIcon" format="boolean" />
        <attr name="ctvStartIconSrc" format="reference" />
        <attr name="ctvEndIconSrc" format="reference" />
    </declare-styleable>
</resources>