    <style name="AppToolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/size_56</item>
        <item name="titleTextAppearance">@style/Heading.H1.S.24</item>
        <item name="android:background">@color/window_bg_color</item>
    </style>

    <style name="PrimaryButton" parent="TextAppearance.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/size_56</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/neutral_950</item>
        <item name="android:fontFamily">@font/inter_semibold_600</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ImageButton.Square" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">@dimen/size_40</item>
        <item name="android:layout_height">@dimen/size_40</item>
        <item name="android:padding">@dimen/size_4</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="Button.1.S.20" parent="BaseTextView">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/inter_semibold_600</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextButton.Primary" parent="Button.1.S.20">
    </style>

    <style name="AdNative.CtaButton" parent="TextButton.Primary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/neutral_950</item>
    </style>

    <style name="SquareImageButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">6dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="Heading2S" parent="BaseTextView">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/inter_semibold_600</item>
